# AVOS Verify — configuration
#
# Everything here is OPTIONAL. With no .env file at all, the app and the full
# evaluation run on a deterministic offline mock: clone, `npm install`,
# `npm run eval`, `npm run dev`. No key, no cost, no signup.
#
# That is a deliberate property, not a convenience. AVOS's headline numbers come
# out of `lib/verifier/deterministic.ts`, which contains no model. If setting a
# key changed a verdict, the architecture would be broken. The mock exists partly
# so a reviewer can check that it does not.

# Enables the live agent, the exception narrator and Q&A.
# The VERDICT is unchanged either way.
OPENAI_API_KEY=

# Model used for the three AI surfaces. Default: gpt-4o-mini
AVOS_LLM_MODEL=gpt-4o-mini

# Force the offline mock even when a key is present.
# Useful for reproducing the committed evaluation numbers exactly.
AVOS_USE_MOCK=0

# Pin the timestamp written into evals/report.md, so re-running the harness
# produces a diff about results rather than about the clock.
# AVOS_RUN_STAMP=2026-08-26T00:00:00Z
