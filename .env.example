# AVOS Verify — configuration
#
# Everything here is OPTIONAL. With no .env file at all, the app and the full
# evaluation run on a deterministic offline mock: clone, `npm install`,
# `npm run eval`, `npm run dev`. No key, no cost, no signup.
#
# That is a deliberate property, not a convenience. AVOS's headline numbers come
# out of `lib/verifier/deterministic.ts`, which contains no model. If setting a
# key changed a verdict, the architecture would be broken. The mock exists partly
# so a reviewer can check that it does not.

# Enables the live agent, the exception narrator and Q&A.
#
# The verdict path contains no model, so setting this SHOULD NOT change a single
# verdict. That is the load-bearing claim of the design — and it is currently
# UNTESTED: no key was present in any environment this was built or evaluated in,
# so every committed number comes from the mock. evals/raw/metrics.live.json
# records that as `skipped_no_key` rather than implying otherwise.
# `npm run eval:live` produces the comparison for real.
OPENAI_API_KEY=

# Or any OpenAI-compatible provider. The product path uses whichever of
# AVOS_LLM_API_KEY / OPENAI_API_KEY is set (AVOS_LLM_API_KEY wins).
#   Groq:   AVOS_LLM_BASE_URL=https://api.groq.com/openai/v1
#           AVOS_LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: AVOS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           AVOS_LLM_MODEL=gemini-2.0-flash
AVOS_LLM_API_KEY=
AVOS_LLM_BASE_URL=

# Model used for the AI surfaces. Default: gpt-4o-mini
AVOS_LLM_MODEL=gpt-4o-mini

# Force the offline mock even when a key is present.
# Useful for reproducing the committed evaluation numbers exactly.
AVOS_USE_MOCK=0

# Pin the timestamp written into evals/report.md, so re-running the harness
# produces a diff about results rather than about the clock.
# AVOS_RUN_STAMP=2026-08-26T00:00:00Z

# Docker only. Switches the build to `output: 'standalone'`.
# Do NOT set this on Vercel — Vercel does its own packaging, and standalone
# output is not what its builder expects.
# AVOS_STANDALONE=1

# --- Razorpay ingestion (optional) ------------------------------------------
#
# Names only, never values. Setting these enables `npm run test:razorpay:live`,
# which fetches one month of the settlement recon report READ-ONLY and normalises
# it into the same ledger shape the CSVs produce.
#
# They are NOT used by:
#   npm run eval          the benchmark is deterministic and credential-free
#   npm run build         nothing in the build reads them
#   the deployed demo     the console renders the committed fixtures
#
# Note on test keys: test-mode transactions are simulated and no money moves, so
# there is nothing for the T+2 settlement cycle to settle; /settlements and the
# recon report come back empty on an `rzp_test_` key. Expected, not a broken adapter.
#
# Server-side only. lib/connectors/razorpay.ts throws at import if it is ever
# pulled into a browser bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
